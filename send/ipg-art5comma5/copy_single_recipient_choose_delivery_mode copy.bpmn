    <bpmn:textAnnotation id="TextAnnotation_0pnz07r">
      <bpmn:text>QUI DOBBIAMO RICHIEDERE TUTTI I REGISTRI                                                        Coda: pn-nationalregistries_to_deliverypush
Message type:  NR_GATEWAY_RESPONSE derivato dal nome della coda.
Message subtype: CHOOSE_DELIVERY derivato da TimelineRepository.getElementById( msg.payload.correlationId ).details.contactPhase</bpmn:text>
    </bpmn:textAnnotation>
